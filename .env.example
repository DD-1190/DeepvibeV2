# ── Project assistant (AI chat + enquiry delivery) ─────────────────────
# Server-side keys: set them in Vercel → Project → Settings → Environment Variables
# (or a local .env.local, which is gitignored). They are never sent to the browser.

# AI conversation (optional). Without a key the assistant runs its scripted flow — still fully usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=minimal   # or low / medium / off
# OPENAI_BASE_URL=https://api.openai.com/v1

# Where confirmed enquiries go. Every one you configure is used.
# A) WhatsApp to Naman (recommended) — CallMeBot, free. One-time setup: see README → "WhatsApp delivery".
CALLMEBOT_API_KEY=
# WHATSAPP_NOTIFY_NUMBER=919873470074   # defaults to site.whatsapp in data/site.ts
# B) Email via Resend (https://resend.com). FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=DeepVibe <hello@deepvibe.in>
# C) Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz
FORMSPREE_ENDPOINT=
# D) Any CRM / Zapier / Make / Slack webhook — receives the enquiry as JSON
CONTACT_WEBHOOK_URL=

# Static hosting only (no server): Web3Forms access key, sent from the browser.
NEXT_PUBLIC_WEB3FORMS_KEY=

# With nothing configured, the final button opens WhatsApp with the enquiry pre-typed to site.whatsapp —
# the visitor presses send. It never claims an enquiry was delivered when it wasn't.
