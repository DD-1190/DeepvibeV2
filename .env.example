# ── Project assistant (AI chat + enquiry delivery) ─────────────────────
# Server-side keys: set them in Vercel → Project → Settings → Environment Variables
# (or a local .env.local, which is gitignored). They are never sent to the browser.

# AI conversation (optional). Without a key the assistant runs its scripted flow — still fully usable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=minimal   # or low / medium / off
# OPENAI_BASE_URL=https://api.openai.com/v1

# Where confirmed enquiries go — configure at least ONE:
# A) Email via Resend (https://resend.com). FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=DeepVibe <hello@deepvibe.in>
# B) Formspree form endpoint, e.g. https://formspree.io/f/abcdwxyz
FORMSPREE_ENDPOINT=
# C) Any CRM / Zapier / Make / Slack webhook — receives the enquiry as JSON
CONTACT_WEBHOOK_URL=

# Static hosting only (no server): Web3Forms access key, sent from the browser.
NEXT_PUBLIC_WEB3FORMS_KEY=

# With nothing configured, the assistant tells visitors their enquiry was NOT sent. It never fakes success.
